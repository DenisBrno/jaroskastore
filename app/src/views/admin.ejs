<!DOCTYPE html>
<html lang="cs">
<head>
    <%- include('partials/head', { title: 'Administrace' }) %>
</head>
<body>
    <div class="container">
        <%- include('partials/top-bar') %>

        <div class="card">
            <h2>Administrace</h2>

            <% if (status === 'user_created') { %>
                <div class="form-success">Uživatel byl vytvořen.</div>
            <% } else if (status === 'credit_added') { %>
                <div class="form-success">Kredit byl změněn.</div>
            <% } else if (status === 'password_set') { %>
                <div class="form-success">Heslo bylo nastaveno, uživatel byl odhlášen na všech zařízeních.</div>
            <% } else if (error === 'user_exists') { %>
                <div class="form-error">Uživatel s tímto jménem už existuje.</div>
            <% } else if (error === 'invalid_password') { %>
                <div class="form-error">Vyplňte jméno a heslo s alespoň <%= minPasswordLength %> znaky.</div>
            <% } else if (error === 'no_user') { %>
                <div class="form-error">Vyberte zákazníka ze seznamu.</div>
            <% } else if (error === 'invalid_charge') { %>
                <div class="form-error">Zadejte nenulovou celou částku kreditu (nejvýše 10 000 Kč).</div>
            <% } else if (error) { %>
                <div class="form-error">Akce se nezdařila. Zkuste to prosím znovu.</div>
            <% } %>
            
            <section class="card-section">
                <h3>Posledních 10 objednávek</h3>
                <div class="table-wrapper table-wrapper-raised">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Datum</th>
                                <th>Zákazník</th>
                                <th>Produkt</th>
                                <th>Počet</th>
                                <th>Učebna</th>
                                <th>Přestávka</th>
                                <th>Poznámka</th>
                                <th>Stav</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (objednavky.length > 0) { %>
                                <% objednavky.forEach(o => { %>
                                    <tr>
                                        <td><%= o.id %></td>
                                        <td><%= new Date(o.created_at).toLocaleString('cs-CZ') %></td>
                                        <td><%= o.customer_name %></td>
                                        <td><%= o.product_name %></td>
                                        <td><%= o.quantity %></td>
                                        <td><%= o.ucebna %></td>
                                        <td><%= o.prestavka_start %> - <%= o.prestavka_end %></td>
                                        <td><%= o.poznamka %></td>
                                        <td>
                                            <div class="status-cell">
                                                <span class="badge <%= o.status ? 'badge-completed' : 'badge-pending' %>">
                                                    <%= o.status ? 'Vyřízeno' : 'Čeká' %>
                                                </span>
                                                <form action="/admin/toggle-order" method="POST" class="form-inline">
                                                    <%- include('partials/csrf') %>
                                                    <input type="hidden" name="orderId" value="<%= o.id %>">
                                                    <button type="submit" class="btn-icon" title="Změnit stav">🔄</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="9">Žádné objednávky.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="card-section">
                <h3>Vytvořit účet pro zákazníka</h3>
                <form action="/admin/create-user" method="POST" class="form form-narrow">
                    <%- include('partials/csrf') %>
                    <div class="form-group">
                        <label for="new_username">Uživatelské jméno</label>
                        <input type="text" id="new_username" name="username" required>
                    </div>
                    <div class="form-group">
                        <label for="new_password">Heslo</label>
                        <input type="password" id="new_password" name="password" minlength="<%= minPasswordLength %>" autocomplete="new-password" required>
                    </div>
                    <button type="submit" class="btn-submit">Vytvořit uživatele</button>
                </form>
            </section>

            <section class="card-section">
                <h3>Dobít kredit zákazníkovi</h3>
                <form action="/admin/addCredit" method="POST" class="form form-narrow">
                    <%- include('partials/csrf') %>
                    <div class="form-group">
                        <label for="customer-search-input">Zákazník</label>
                        <%- include('partials/customer-search') %>
                    </div>

                    <div class="form-group">
                        <label for="charge">Kredit</label>
                        <input type="number" id="charge" name="charge" step="1" min="-10000" max="10000" required>
                    </div>
                    <button type="submit" class="btn-submit">Dobít kredit</button>
                </form>
            </section>

            <section class="card-section">
                <h3>Nastavit nové heslo</h3>
                <form action="/admin/set-password" method="POST" class="form form-narrow">
                    <%- include('partials/csrf') %>
                    <div class="form-group">
                        <label for="password-user-search">Uživatel</label>
                        <%- include('partials/customer-search', { inputId: 'password-user-search' }) %>
                    </div>
                    <div class="form-group">
                        <label for="reset_password">Nové heslo</label>
                        <input type="password" id="reset_password" name="password" minlength="<%= minPasswordLength %>" autocomplete="new-password" required>
                    </div>
                    <button type="submit" class="btn-submit">Nastavit heslo</button>
                </form>
            </section>
            
            <a href="/" class="link-cancel">Zpět na hlavní stránku</a>
        </div>
    </div>
</body>
</html>
