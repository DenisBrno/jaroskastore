<!DOCTYPE html>
<html lang="cs">
<head>
    <%- include('partials/head', { title: 'Databázová konzole' }) %>
</head>
<body>
    <div class="container">
        <%- include('partials/top-bar') %>
        
        <div class="card">
            <h2>Databázový dotaz</h2>
            <form action="/admin/db-query" method="post" class="form">
                <%- include('partials/csrf') %>
                <textarea name="query" id="query"></textarea>
                <button type="submit" class="btn-submit">Odeslat</button>
            </form>
        </div>
        <div class="output-card">
            <h3>Výsledek</h3>
            <%- dbOutput %>
        </div>
    </div>
</body>
</html>
