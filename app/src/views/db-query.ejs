<!DOCTYPE html>
<html lang="cs">
<head>
    <%- include('partials/head', { title: 'Admin Panel' }) %>
</head>
<body>
    <div class="container">
        <%- include('partials/auth_bar', { session: session }) %>
        
        <div class="admin-panel">
            <h2>DB Query</h2>
            <form action="/admin/db-query" method="post">
                <textarea name="query" id="query"></textarea>
                <button type="submit" class="btn-submit">Odeslat</button>
            </form>
        </div>
        <div class="db-output-container">
            <h3>DB Output</h3>
            <%- dbOutput %>
        </div>
    </div>
</body>
</html>
