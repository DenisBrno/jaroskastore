<!DOCTYPE html>
<html lang="cs">
<head>
    <%- include('../partials/head', { title: 'Podrobná tabulka prodejů' }) %>
</head>
<body>
    <div class="container">
        <%- include('../partials/top-bar', { session: session }) %>
        
        <div class="page-header">
            <h1>Podrobná tabulka prodejů</h1>
            <a href="/finances" class="btn-back">Zpět na finance</a>
        </div>

        <div class="panel">
            <h2>Filtry</h2>
            <form action="/finances/table" method="GET" class="filter-form form">
                <div class="form-group">
                    <label for="produkt">Produkt</label>
                    <select name="produkt" id="produkt">
                        <option value="">Všechny produkty</option>
                        <% produktyList.forEach(p => { %>
                            <option value="<%= p %>" <%= selectedProdukt === p ? 'selected' : '' %>><%= p %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="dny">Časové období</label>
                    <select name="dny" id="dny">
                        <option value="" <%= selectedDny === '' ? 'selected' : '' %>>Všechna období</option>
                        <option value="1" <%= selectedDny === '1' ? 'selected' : '' %>>Posledních 24 hodin</option>
                        <option value="7" <%= selectedDny === '7' ? 'selected' : '' %>>Posledních 7 dní</option>
                        <option value="30" <%= selectedDny === '30' ? 'selected' : '' %>>Posledních 30 dní</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary">Filtrovat</button>
                    <a href="/finances/table" class="btn">Reset</a>
                </div>
            </form>
        </div>

        <div class="panel">
            <h2>Seznam prodejů</h2>
            <div class="table-wrapper table-wrapper-bordered">
                <table>
                    <thead>
                        <tr>
                            <th>Datum a čas</th>
                            <th>Produkt</th>
                            <th>Množství</th>
                            <th>Cena za kus</th>
                            <th>Celkem</th>
                            <th>Poznámka</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (pohyby.length === 0) { %>
                            <tr>
                                <td colspan="6" class="table-empty">Žádné prodeje nenalezeny pro vybrané filtry.</td>
                            </tr>
                        <% } else { %>
                            <% pohyby.forEach(pohyb => { %>
                                <tr>
                                    <td><%= new Date(pohyb.cas).toLocaleString('cs-CZ') %></td>
                                    <td><strong><%= pohyb.produkt %></strong></td>
                                    <td><%= pohyb.mnozstvi %> ks</td>
                                    <td><%= pohyb.cena_za_kus %> Kč</td>
                                    <td><%= pohyb.celkem %> Kč</td>
                                    <td><span class="table-note"><%= pohyb.poznamka %></span></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="stat-grid">
            <div class="stat-card">
                <h3>Celkem prodáno kusů</h3>
                <div class="stat-value"><%= totalSold %> ks</div>
            </div>
            <div class="stat-card stat-card-profit">
                <h3>Celkový příjem z prodejů</h3>
                <div class="stat-value"><%= totalProfit.toFixed(0) %> Kč</div>
            </div>
        </div>

        <a href="/" class="link-muted">Zpět na hlavní stránku</a>
    </div>
</body>
</html>
