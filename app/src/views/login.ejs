<!DOCTYPE html>
<html lang="cs">
<head>
    <%- include('partials/head', { title: 'Přihlášení' }) %>
</head>
<body>
    <div class="container">
        <div class="card">
            <form action="/login" method="POST" class="form">
                <%- include('partials/csrf') %>
                <h2>Přihlášení</h2>
                
                <% if (error === 'invalid') { %>
                    <div class="form-error">Neplatné jméno nebo heslo.</div>
                <% } else if (error === 'too_many') { %>
                    <div class="form-error">Příliš mnoho neúspěšných pokusů. Zkuste to znovu za 15 minut.</div>
                <% } %>

                <div class="form-group">
                    <label for="username">Uživatelské jméno</label>
                    <input type="text" id="username" name="username" autocomplete="username" required>
                </div>
                <div class="form-group">
                    <label for="password">Heslo</label>
                    <input type="password" id="password" name="password" autocomplete="current-password" required>
                </div>
                <button type="submit" class="btn-submit">Přihlásit se</button>
            </form>
            <a href="/register" class="link-muted">Nemáte účet? Zaregistrujte se</a>
            <a href="/" class="link-muted">Zpět na hlavní stránku</a>
        </div>
    </div>
</body>
</html>
