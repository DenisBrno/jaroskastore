<div class="auth-bar" id="auth-bar">
    <% if (session && session.username) { %>
        <div class="user-info">
            <span>Ahoj, <%= session.username %></span>
            <% if (session.userId === 0) { %>
                <a href="/admin" class="btn-auth btn-admin">Admin</a>
                <a href="/payment" class="btn-auth btn-admin">Payment</a>
                <a href="/finances" class="btn-auth btn-admin">Finances</a>
            <% } %>
            <a href="/order" class="btn-auth btn-order">Objednat</a>
            <form action="/logout" method="POST" style="margin:0">
                <button type="submit" class="btn-auth btn-logout">Odhlásit se</button>
            </form>
        </div>
    <% } else { %>
        <a href="/login" class="btn-auth">Přihlásit se</a>
        <a href="/register" class="btn-auth">Registrace</a>
    <% } %>
</div>
