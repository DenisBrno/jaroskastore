<div class="top-bar">
    <% if (user) { %>
        <div class="top-bar-user">
            <span>Ahoj, <%= user.login %></span>
            <% if (hasRole('admin')) { %>
                <a href="/admin" class="btn btn-warning">Administrace</a>
                <a href="/payment" class="btn btn-warning">Platba</a>
                <a href="/finances" class="btn btn-warning">Finance</a>
            <% } %>
            <% if (hasRole('admin', 'terminal')) { %>
                <a href="/toasty/terminal" class="btn btn-warning">Terminál</a>
            <% } %>
            <a href="/order" class="btn btn-primary">Objednat</a>
            <a href="/profile" class="btn">Profil</a>
            <form action="/logout" method="POST" class="form-inline">
                <%- include('csrf') %>
                <button type="submit" class="btn btn-danger">Odhlásit se</button>
            </form>
        </div>
    <% } else { %>
        <a href="/login" class="btn">Přihlásit se</a>
        <a href="/register" class="btn">Registrace</a>
    <% } %>
</div>
