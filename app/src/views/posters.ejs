<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram Posters - Jaroska.store</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&display=swap');

        body {
            margin: 0;
            padding: 40px;
            background-color: #333;
            font-family: 'Montserrat', sans-serif;
            display: flex;
            flex-wrap: wrap;
            gap: 40px;
            justify-content: center;
        }

        .poster {
            width: 1080px;
            height: 1080px; /* Square format for Instagram Post */
            background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%);
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 50px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 80px;
            box-sizing: border-box;
            transform: scale(0.4); /* Scaled down for preview */
            transform-origin: top left;
            margin-bottom: -648px; /* Compensate for scale (1080 * 0.6) */
            margin-right: -648px;
        }

        /* Wrapper to handle the scaling layout */
        .poster-wrapper {
            width: 432px; /* 1080 * 0.4 */
            height: 432px;
            margin-bottom: 40px;
        }

        .brand-header {
            font-size: 3em;
            font-weight: 900;
            color: #004aad;
            text-transform: uppercase;
            letter-spacing: 5px;
            margin-bottom: 20px;
        }

        .product-image-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            position: relative;
            z-index: 2;
        }

        .product-image {
            max-width: 80%;
            max-height: 500px;
            filter: drop-shadow(0 30px 40px rgba(0, 74, 173, 0.25));
            transform: rotate(-5deg);
            transition: transform 0.3s;
        }

        .product-info {
            text-align: center;
            z-index: 2;
        }

        .product-name {
            font-size: 3.5em;
            font-weight: 800;
            color: #1e293b;
            margin: 0 0 20px 0;
            line-height: 1.1;
        }

        .product-price-tag {
            display: inline-block;
            background: #004aad;
            color: white;
            font-size: 4em;
            font-weight: 900;
            padding: 20px 60px;
            border-radius: 100px;
            box-shadow: 0 20px 40px -10px rgba(0, 74, 173, 0.4);
            transform: rotate(2deg);
        }

        .footer {
            margin-top: 60px;
            text-align: center;
            color: #64748b;
            font-size: 1.5em;
            font-weight: 600;
            border-top: 2px solid #e2e8f0;
            padding-top: 40px;
            width: 100%;
        }

        .footer strong {
            color: #004aad;
        }

        /* Decorative Elements */
        .circle {
            position: absolute;
            border-radius: 50%;
            z-index: 1;
        }
        
        .circle-1 {
            width: 600px;
            height: 600px;
            background: linear-gradient(45deg, #e0f2fe, #fff);
            top: -200px;
            right: -200px;
        }

        .circle-2 {
            width: 400px;
            height: 400px;
            background: #f1f5f9;
            bottom: 100px;
            left: -100px;
        }

        .stock-badge {
            position: absolute;
            top: 80px;
            left: 80px;
            background: #ef4444;
            color: white;
            font-weight: 800;
            padding: 15px 30px;
            border-radius: 15px;
            font-size: 1.5em;
            transform: rotate(-10deg);
            box-shadow: 0 10px 20px rgba(239, 68, 68, 0.3);
            z-index: 3;
        }

        .download-hint {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: #004aad;
            color: white;
            text-align: center;
            padding: 10px;
            font-size: 14px;
            z-index: 1000;
        }
    </style>
</head>
<body>

    <div class="download-hint">
        💡 Tip: Pro uložení obrázku udělej screenshot (Výstřižky / Shift+Win+S).
    </div>

    <% produkty.forEach(product => { %>
        <div class="poster-wrapper">
            <div class="poster">
                <div class="circle circle-1"></div>
                <div class="circle circle-2"></div>
                
                <% if (product.skladem < 2 && product.skladem > 0) { %>
                    <div class="stock-badge">POSLEDNÍ KUSY!</div>
                <% } else if (product.skladem == 0) { %>
                    <div class="stock-badge" style="background: #64748b;">VYPRODÁNO</div>
                <% } %>

                <div class="brand-header">JAROŠKA.STORE</div>
                
                <div class="product-image-container">
                    <img src="<%= product.img %>" alt="<%= product.nazev %>" class="product-image">
                </div>
                
                <div class="product-info">
                    <h2 class="product-name"><%= product.nazev %></h2>
                    <div class="product-price-tag"><%= product.cena %> Kč</div>
                </div>

                <div class="footer">
                    Objednávej na webu nebo piš na IG: <strong>@jaroska.store</strong>
                </div>
            </div>
        </div>
    <% }); %>

</body>
</html>
