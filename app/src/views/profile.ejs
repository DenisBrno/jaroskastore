<!DOCTYPE html>
<html lang="cs">
<head>
    <%- include('partials/head', { title: 'Profil' }) %>
</head>
<body>
    <div class="container">
        <%- include('partials/top-bar') %>

        <div class="card card-narrow">
            <h2>Ahoj, <%= user.login %>!</h2>

            <section class="card-section">
                <h3>Můj účet</h3>
                <dl class="profile-details">
                    <dt>Uživatelské jméno</dt>
                    <dd><%= user.login %></dd>
                    <dt>Kredit</dt>
                    <dd class="<%= credit < 0 ? 'is-negative' : '' %>"><%= credit %> Kč</dd>
                </dl>
            </section>

            <section class="card-section">
                <h3>Změna hesla</h3>
                <form action="/profile/password" method="POST" class="form form-narrow">
                    <%- include('partials/csrf') %>

                    <% if (status === 'password_changed') { %>
                        <div class="form-success">Heslo bylo změněno. Na ostatních zařízeních jste byli odhlášeni.</div>
                    <% } else if (error === 'wrong_password') { %>
                        <div class="form-error">Současné heslo není správné.</div>
                    <% } else if (error === 'too_short') { %>
                        <div class="form-error">Nové heslo musí mít alespoň <%= minPasswordLength %> znaků.</div>
                    <% } else if (error === 'mismatch') { %>
                        <div class="form-error">Nová hesla se neshodují.</div>
                    <% } else if (error) { %>
                        <div class="form-error">Heslo se nepodařilo změnit. Zkuste to prosím znovu.</div>
                    <% } %>

                    <%# Hidden username helps password managers save the new password to the right account %>
                    <input type="text" name="username" value="<%= user.login %>" autocomplete="username" hidden>
                    <div class="form-group">
                        <label for="currentPassword">Současné heslo</label>
                        <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required>
                    </div>
                    <div class="form-group">
                        <label for="newPassword">Nové heslo</label>
                        <input type="password" id="newPassword" name="newPassword" minlength="<%= minPasswordLength %>" autocomplete="new-password" required>
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword">Nové heslo znovu</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" minlength="<%= minPasswordLength %>" autocomplete="new-password" required>
                    </div>
                    <button type="submit" class="btn-submit">Změnit heslo</button>
                </form>
            </section>

            <a href="/" class="link-cancel">Zpět na hlavní stránku</a>
        </div>
    </div>
</body>
</html>
