<!DOCTYPE html>
<html lang="cs">
<head>
    <%- include('partials/head', { title: 'Týdenní rozvrh' }) %>
</head>
<body>
    <div class="container">
        <%- include('partials/top-bar') %>

        <div class="schedule">
            <header class="page-header">
                <h1>Týdenní rozvrh</h1>
                <a href="/" class="btn-back">← Zpět k produktům</a>
            </header>
            <div class="schedule-grid">
                <% 
                const dnyNázvy = {
                    "Po": "Pondělí",
                    "Út": "Úterý",
                    "St": "Středa",
                    "Čt": "Čtvrtek",
                    "Pá": "Pátek"
                };
                const ted = new Date();
                const dnyZkratky = ["Ne", "Po", "Út", "St", "Čt", "Pá", "So"];
                const dnesZkratka = dnyZkratky[ted.getDay()];

                for (const [zkratka, nazev] of Object.entries(dnyNázvy)) {
                    const lekceDne = rozvrh[zkratka] || [];
                    const jeDnes = zkratka === dnesZkratka;
                %>
                    <div class="schedule-day <%= jeDnes ? 'is-today' : '' %>">
                        <h2><%= nazev %></h2>
                        <div class="lesson-list">
                            <% if (lekceDne.length > 0) { %>
                                <% lekceDne.forEach(l => { 
                                    const jeAktualni = aktualniLekce && 
                                                     jeDnes && 
                                                     l.hodina === aktualniLekce.hodina && 
                                                     l.ucebna === aktualniLekce.ucebna;
                                %>
                                    <div class="lesson <%= jeAktualni ? 'is-current' : '' %>">
                                        <span class="lesson-time"><%= l.hodina %></span>
                                        <span class="lesson-room"><%= l.ucebna %></span>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p class="lesson-empty">V tento den nejsem ve škole.</p>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
