<!DOCTYPE html>
<html lang="cs">
<head>
    <%- include('../partials/head', { title: 'Bistro Napoleon Terminal' }) %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode/1.5.1/qrcode.min.js"></script>
    <style>
        #qr-wrap {
            margin-top: 25px;
            display: flex;
            justify-content: center;
            min-height: 250px;
        }
        canvas {
            border: 1px solid #e2e8f0;
            padding: 10px;
            background: #fff;
            border-radius: 12px;
        }
        .footer-account { margin-top: 15px; font-size: 14px; color: #64748b; }
    </style>
</head>
<body>
    <div class="container">
        <%- include('../partials/auth_bar', { session: session }) %>
        <h1>Platební terminál Bistra Napoleon</h1>
            <form class="terminal" method="post" action="/bistro-payment">
                <div class="toast-form">
                        <h2>Bistro Napoleon</h2>
                        <div class="toast-selection" style="margin-bottom: 25px;">
                            <div class="image-container" style="height: 350px;">
                                <img class="toast-image" src="../../img/logo.png" alt="">
                                <div class="toast-content" style="display: flex; align-items: center; gap: 8px;">
                                    <button type="button" onclick="changeQty('toast', -1)" style="width: 28px; height: 28px; padding: 0; display: flex; align-items: center; justify-content: center; background: #e2e8f0; color: #475569; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">-</button>
                                    <input type="number" name="qty-1toast" id="toast" class="toast-qty" data-price="25" value="0" min="0"  readonly style="width: 60px; text-align: center; border: none; background: transparent; font-weight: 700; font-size: 1em; -appearance: textfield;">
                                    <button type="button" onclick="changeQty('toast', 1)" style="width: 28px; height: 28px; padding: 0; display: flex; align-items: center; justify-content: center; background: #004aad; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">+</button>
                                </div>
                            </div>
                            <div class="form-group" style="background: #f0f7ff; padding: 15px; border-radius: 12px; border: 1px solid #004aad;">
                                <label for="amount" style="color: #004aad;">Celková částka k zaplacení</label>
                                <input type="number" id="amount-toast" name="amount" value="0" step="1" oninput="updateQR()" style="font-size: 1.5em; font-weight: 800; color: #004aad; border-color: #004aad;">
                                <label for="sleva" style="color: #004aad;">Sleva</label>
                                <input type="number" id="sleva" name="sleva" value="0" step="1"  style="font-size: 1.5em; font-weight: 800; color: #004aad; border-color: #004aad;">
                            </div>

                            <label for="paymentMethod">Payment method</label>
                            <select name="paymentMethod" id="payment-method"  onclick="updatePaymentToast(this.value)">
                                <option value="qr">QR</option>
                                <option value="cash">Cash</option>
                            </select>
                                <div id="qr-section-wrap-toast">
                                    <button type="button" class="btn-submit" onclick="updateQR()" style="margin-top: 20px;">Obnovit QR kód</button>

                                    <div id="qr-wrap">
                                        <canvas id="canvas-toast"></canvas>
                                    </div>
                
                                    <div class="footer-account">
                                        Účet: <b>CZ9120100000002103161375</b>
                                </div>
                            </div>
                        </div>
                </div>
                <div class="auth-form-container">
                    <div class="auth-form">
                            <h2>Jaroska.store</h2>
                            
                            <div class="product-selection" style="margin-bottom: 25px;">
                                <div class="product-list" style="max-height: 350px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 12px; padding: 10px; background: #f8fafc;">
                                    <% produkty.forEach((product, index) => { %>
                                        <div class="product-item-row" style="display: flex; align-items: center; justify-content: space-between; padding: 10px; border-bottom: 1px solid #e2e8f0; background: white; margin-bottom: 5px; border-radius: 8px;">
                                            <div style="display: flex; align-items: center; gap: 12px;">
                                                <img src="<%= product.img %>" alt="<%= product.nazev %>" style="width: 40px; height: 40px; object-fit: contain;">
                                                <div>
                                                    <div style="font-weight: 600; font-size: 0.95em;"><%= product.nazev %></div>
                                                    <div style="font-size: 0.85em; color: #64748b;"><%= product.cena %> Kč | Skladem: <%= product.skladem %></div>
                                                </div>
                                            </div>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <button type="button" onclick="changeQty('<%= product.nazev %>', -1)" style="width: 28px; height: 28px; padding: 0; display: flex; align-items: center; justify-content: center; background: #e2e8f0; color: #475569; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">-</button>
                                                <input type="number" name="qty-<%= product.nazev %>" id="qty-<%= product.nazev %>" class="product-qty" data-price="<%= product.cena %>" value="0" min="0"  readonly style="width: 60px; text-align: center; border: none; background: transparent; font-weight: 700; font-size: 1em; -appearance: textfield;">
                                                <button type="button" onclick="changeQty('<%= product.nazev %>', 1)" style="width: 28px; height: 28px; padding: 0; display: flex; align-items: center; justify-content: center; background: #004aad; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">+</button>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>


                            <div class="form-group" style="background: #f0f7ff; padding: 15px; border-radius: 12px; border: 1px solid #004aad;">
                                <label for="amount" style="color: #004aad;">Celková částka k zaplacení</label>
                                <input type="number" id="amount" name="amount" value="0" step="1" oninput="updateQR()" style="font-size: 1.5em; font-weight: 800; color: #004aad; border-color: #004aad;">
                                <label for="sleva" style="color: #004aad;">Sleva</label>
                                <input type="number" id="sleva" name="sleva" value="0" step="1"  style="font-size: 1.5em; font-weight: 800; color: #004aad; border-color: #004aad;">
                            </div>
                            
                            <label for="paymentMethod">Payment method</label>
                            <select name="paymentMethod" id="payment-method"  onclick="updatePayment(this.value)">
                                <option value="qr">QR</option>
                                <option value="cash">Cash</option>
                                <option value="credit">Credit</option>
                            </select>
                            <div id="qr-section-wrap">
                                <button type="button" class="btn-submit" onclick="updateQR()" style="margin-top: 20px;">Obnovit QR kód</button>

                                <div id="qr-wrap">
                                    <canvas id="canvas"></canvas>
                                </div>
            
                                <div class="footer-account">
                                    Účet: <b>CZ9120100000002103161375</b>
                                </div>
                            </div>
                            <div id="credit-section-wrap" style="display: none;">
                                <input 
                                    type="text" 
                                    id="searchInput" 
                                    placeholder="Search and select user..." 
                                    autocomplete="off"
                                >
                                <input type="hidden" id="selectedUserId" name="userId">

                                <div class="dropdown-list" id="dropdownList"></div>
                                <script>
                                    const searchInput = document.getElementById('searchInput');
                                    const dropdownList = document.getElementById('dropdownList');
                                    const selectedUserId = document.getElementById('selectedUserId');

                                    searchInput.addEventListener('input', (e) => {
                                        const searchTerm = e.target.value.toLowerCase();
                                        dropdownList.innerHTML = '';

                                        if (!searchTerm) {
                                            dropdownList.classList.remove('show');
                                            return;
                                        }

                                        if(searchTerm.length < 3) {
                                            return;
                                        }

                                        let users = []; 

                                        function handleSearch(data) {
                                            users = data; 
                                            console.log("Data is finally loaded:", users);

                                            if (users.length > 0) {
                                            users.forEach(user => {
                                                const item = document.createElement('div');
                                                item.classList.add('dropdown-item');
                                                item.setAttribute('id',`dropdown-item-${user.id}`);
                                                item.textContent = user.id+' '+user.login+' '+user.kredit+' Kč';
                                                
                                                item.addEventListener('click', () => {
                                                    searchInput.value = user.login;        
                                                    selectedUserId.value = user.id;       
                                                    dropdownList.classList.remove('show');
                                                    console.log(`Selected User ID: ${user.id}`);
                                                    let items = [];
                                                    items = document.getElementsByClassName('dropdown-item');
                                                    for (let i = 0; i < items.length; i++) {
                                                        if(items[i].attributes.id.value.endsWith(user.id)){
                                                            items[i].style.color='red';
                                                        } else {
                                                            items[i].style.color='black';
                                                        }
                                                    }
                                                });

                                                dropdownList.appendChild(item);
                                            });
                                                dropdownList.classList.add('show');
                                            } else {
                                                // If no users match, show a "No results" message or hide it
                                                dropdownList.classList.remove('show');
                                            }
                                            
                                        }

                                        // The fetch operation
                                        fetch(`/api/users?search=${encodeURIComponent(searchTerm)}`)
                                            .then(res => res.json())
                                            .then(data => {
                                                handleSearch(data); 
                                            });
                                        });

                                </script>
                            </div>

                    </div>
                </div>
                <div class="payment">
                    <button type="submit" class="btn-submit">Zaplatit</button>
                    <a href="/" class="btn-cancel">Zpět na hlavní stránku</a>
                </div>
 
            </form>

            

    </div>

        <script>
        const MY_IBAN = 'CZ9120100000002103161375';
        
        function changeQty(index, delta, max) {


            if(index != "toast") {
                const input = document.getElementById(`qty-${index}`);
                let val = parseInt(input.value) + delta;
                if (val < 0) val = 0;
                if (max !== undefined && val > max) val = max;
                input.value = val;
                calculateTotal();
            } else {
                const input = document.getElementById(`${index}`);
                let val = parseInt(input.value) + delta;
                if (val < 0) val = 0;
                if (max !== undefined && val > max) val = max;
                input.value = val;
                calculateToast(val)
            }

            
        }

        function calculateTotal() {
            let total = 0;
            document.querySelectorAll('.product-qty').forEach(input => {
                const qty = parseInt(input.value);
                const price = parseInt(input.dataset.price);
                total += qty * price;
            });
            document.getElementById('amount').value = total;
            updateQR();
        }

        function calculateToast(val) {
            let total = Math.trunc(val/2)*45+(val%2)*25
            document.getElementById('amount-toast').value = total;
            updateToastQR();
        }

        function createSpayd(amount) {
            const formattedAmount = parseFloat(amount).toFixed(2);
            return `SPD*1.0*ACC:${MY_IBAN}*AM:${formattedAmount}*CC:CZK`;
        }

        function updateQR() {
            const amount = document.getElementById('amount').value;
            const canvas = document.getElementById('canvas');
            
            if (amount <= 0) {
                canvas.style.display = 'none';
                return;
            }
            canvas.style.display = 'block';

            const spaydString = createSpayd(amount);

            QRCode.toCanvas(canvas, spaydString, {
                width: 250,
                margin: 2,
                errorCorrectionLevel: 'M'
            }, function (error) {
                if (error) console.error(error);
            });
        }

        function updateToastQR() {
            const amount = document.getElementById('amount-toast').value;
            const canvas = document.getElementById('canvas-toast');

            if (amount <= 0) {
                canvas.style.display = 'none';
                return;
            }
            canvas.style.display = 'block';

            const spaydString = createSpayd(amount);
            
            QRCode.toCanvas(canvas, spaydString, {
                width: 250,
                margin: 2,
                errorCorrectionLevel: 'M'
            }, function (error) {
                if (error) console.error(error);
            });
            console.log(canvas);
        }


        function updatePayment(method){
            qr_wrapper = document.getElementById("qr-section-wrap");
            credit_wrapper = document.getElementById("credit-section-wrap");
            if( method=="qr") {
                qr_wrapper.style.display = 'block';
                credit_wrapper.style.display = 'none';
            } else if ( method=="credit"){ 
                qr_wrapper.style.display = 'none';
                credit_wrapper.style.display = 'block';
            } else {
                qr_wrapper.style.display = 'none';
                credit_wrapper.style.display = 'none';
            }
        }

        function updatePaymentToast(method){
            qr_wrapper = document.getElementById("qr-section-wrap-toast");
            if( method=="qr") {
                qr_wrapper.style.display = 'block';
            } else {
                qr_wrapper.style.display = 'none';
            }
        }
        window.onload = updateQR;
    </script>
</body>
</html>
