<!DOCTYPE html>
<html lang="cs">
<head>
    <%- include('../partials/head', { title: 'Terminál Bistra Napoleon' }) %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode/1.5.1/qrcode.min.js"></script>
    <script src="/scripts/checkout.js" defer></script>
</head>
<body>
    <div class="container">
        <%- include('../partials/top-bar') %>
        <h1>Platební terminál Bistra Napoleon</h1>

        <%- include('../partials/payment-messages') %>

        <form class="terminal-grid form" method="post" action="/bistro-payment">
            <%# Toast card is only a QR calculator, none of its fields are submitted %>
            <div class="card">
                <h2>Bistro Napoleon</h2>
                <div class="toast-panel">
                    <div class="toast-display">
                        <img class="toast-image" src="<%= logoPath %>" alt="Bistro Napoleon">
                        <div class="toast-controls qty-control">
                            <button type="button" class="qty-btn qty-btn-minus" data-qty-step="-1">-</button>
                            <input type="number" id="toast" class="qty-input" value="0" min="0" readonly>
                            <button type="button" class="qty-btn qty-btn-plus" data-qty-step="1">+</button>
                        </div>
                    </div>
                    <div class="form-group amount-box">
                        <label for="amount-toast">Celková částka k zaplacení</label>
                        <input type="number" id="amount-toast" value="0" step="1">
                    </div>

                    <label for="payment-method-toast">Způsob platby</label>
                    <select id="payment-method-toast">
                        <option value="qr">QR</option>
                        <option value="cash">Hotově</option>
                    </select>
                    <%- include('../partials/qr-payment', { sectionId: 'qr-section-wrap-toast', canvasId: 'canvas-toast', refresh: 'updateToastQR' }) %>
                </div>
            </div>
            <div class="card">
                <h2>Jaroska.store</h2>
                <%- include('../partials/product-picker') %>
                <%- include('../partials/shop-payment') %>
            </div>
            <div class="terminal-actions">
                <button type="submit" class="btn-submit">Zaplatit</button>
                <a href="/" class="link-cancel">Zpět na hlavní stránku</a>
            </div>
        </form>
    </div>

    <script>
        // Toasts: 1 for 25 Kč, 2 for 45 Kč
        const TOAST_PRICE = 25;
        const TOAST_PAIR_PRICE = 45;

        function updateToastQR() {
            renderQR('canvas-toast', Number(document.getElementById('amount-toast').value));
        }

        document.getElementById('toast').addEventListener('change', (e) => {
            const count = parseInt(e.target.value);
            document.getElementById('amount-toast').value = Math.trunc(count / 2) * TOAST_PAIR_PRICE + (count % 2) * TOAST_PRICE;
            updateToastQR();
        });
        document.getElementById('amount-toast').addEventListener('input', updateToastQR);
        document.getElementById('payment-method-toast').addEventListener('change', (e) => {
            document.getElementById('qr-section-wrap-toast').style.display = e.target.value === 'qr' ? 'block' : 'none';
        });
        window.addEventListener('load', updateToastQR);
    </script>
</body>
</html>
